#!/bin/bash

update_theme() {
    #set the xfce and GTK theme
    xfconf-query -c xsettings -p /Net/IconThemeName -s "Adwaita-dark"
    gsettings set org.gnome.desktop.interface icon-theme "Adwaita-dark"

    xfconf-query -c xsettings -p /Net/ThemeName -s "Adwaita-dark"
    gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"
}

restart_waybar() {
    # hyprv_util runs on start and on every config reload, so two restarts can overlap and leave duplicate bars; the lock serializes them
    # fd 9 is closed for the bars so they don't hold the lock for as long as they run
    (
        flock 9

        #restart the waybar
        pkill waybar
        waybar 9>&- &
    ) 9>"${XDG_RUNTIME_DIR:-/tmp}/hyprv-waybar.lock"
}
