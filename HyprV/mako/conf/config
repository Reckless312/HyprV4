# GLOBAL
max-history=100
sort=-time

# BINDING OPTIONS
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss
#on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/message.oga

# STYLE OPTIONS
font=Fantasque Sans Mono 14
width=300
height=100
margin=10
padding=15
border-size=2
border-radius=10
icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1
history=1
text-alignment=center
default-timeout=5000
ignore-timeout=0
max-visible=5
layer=overlay
anchor=center

background-color=#1a1110
text-color=#f1dfdc
border-color=#534341
progress-color=over #ffb4a8

[urgency=low]
border-color=#534341
default-timeout=2000

[urgency=normal]
border-color=#534341
default-timeout=5000

[urgency=high]
border-color=#ffb4ab
text-color=#ffb4ab
default-timeout=0

[category=mpd]
border-color=#dec48c
default-timeout=2000
group-by=category